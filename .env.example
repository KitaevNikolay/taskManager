# Входящий вебхук Битрикс24 (скоупы: task, tasks; желательно ещё user, department)
BITRIX_TASK_WEBHOOK=https://portal.example.ru/rest/1/xxxxxxxx/
# ID группы (проекта) отдела
BITRIX_GROUP=28
# Порт сервера
PORT=3001
# Путь к БД SQLite
DB_PATH=./data/app.db
# Контакт для Web Push (mailto: или https:), необязательно
PUSH_CONTACT=

# Адрес приложения — для ссылок в письмах восстановления пароля
APP_URL=http://localhost:3001

# Почта для восстановления пароля (если не задано — сброс только командой npm run reset-password -- <логин>)
SMTP_HOST=
SMTP_PORT=587
# true для порта 465 (SSL)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Отправитель, например "Задачи отдела <noreply@example.ru>"
SMTP_FROM=
