{
  "name": "b24-task-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx --env-file=.env server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "reset-password": "tsx --env-file=.env server/reset-password.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^10.0.13",
    "tsx": "^4.20.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "dompurify": "^3.4.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
